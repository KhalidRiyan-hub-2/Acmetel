---
// Stylised route + waveform panel for the Voice hero. Decorative only; no data claims.
import Icon from '../Icon.astro';
const bars = [18, 34, 52, 28, 64, 80, 46, 70, 38, 88, 56, 30, 72, 44, 22, 58, 36, 16];
const hops = [
  { icon: 'building', label: 'Your network' },
  { icon: 'route', label: 'Acmetel routing' },
  { icon: 'globe', label: 'Global destinations' },
] as const;
---
<div aria-hidden="true" class="relative mx-auto w-full max-w-md">
  <div class="absolute -inset-8 rounded-full bg-teal-500/15 blur-3xl"></div>
  <div class="glass relative p-6 sm:p-7">
    <div class="flex items-center justify-between">
      <p class="eyebrow">Live route</p>
      <span class="inline-flex items-center gap-2 text-sm text-ink-muted">
        <span class="relative flex size-2"><span class="absolute inline-flex size-full animate-ping rounded-full bg-teal-400 opacity-75"></span><span class="relative inline-flex size-2 rounded-full bg-teal-400"></span></span>
        Carrier-grade
      </span>
    </div>

    <div class="mt-6 flex h-28 items-center justify-between gap-1 rounded-2xl border border-line bg-navy-950/60 px-4">
      {bars.map((h, i) => (
        <span class="w-1.5 rounded-full bg-gradient-to-t from-green-700 to-teal-400" style={`height:${h}%;opacity:${0.45 + (i % 5) * 0.12}`}></span>
      ))}
    </div>

    <ol class="relative mt-7 grid grid-cols-3 gap-2">
      <svg viewBox="0 0 300 4" preserveAspectRatio="none" class="absolute left-[16%] top-6 h-1 w-[68%]" fill="none">
        <line x1="0" y1="2" x2="300" y2="2" class="animate-dash stroke-teal-400" stroke-width="2" stroke-dasharray="10 14" stroke-linecap="round" />
      </svg>
      {hops.map((h) => (
        <li class="relative flex flex-col items-center text-center">
          <span class="grid size-12 place-items-center rounded-xl border border-teal-500/30 bg-navy-800 text-teal-300"><Icon name={h.icon} /></span>
          <span class="mt-3 text-sm text-ink-muted">{h.label}</span>
        </li>
      ))}
    </ol>

    <div class="mt-6 flex flex-wrap gap-2">
      {['Tier-1 carriers', 'Low latency', 'Optimised routing'].map((t) => (
        <span class="rounded-full border border-line-strong bg-white/[0.03] px-3 py-1.5 text-sm text-ink">{t}</span>
      ))}
    </div>
  </div>
</div>
