---
// CSS-only phone frame. Slot content renders as the screen (keep it simple: a few stacked rows).
interface Props { class?: string; tilt?: boolean }
const { class: className = '', tilt = true } = Astro.props;
---
<div aria-hidden="true" class:list={['relative mx-auto w-60 sm:w-64', tilt && 'lg:rotate-[-6deg]', className]}>
  <div class="absolute -inset-10 rounded-full bg-teal-500/25 blur-3xl"></div>
  <div class="relative rounded-[2.6rem] border border-white/15 bg-gradient-to-b from-navy-700 to-navy-950 p-2.5 shadow-2xl shadow-black/60">
    <div class="relative overflow-hidden rounded-[2.1rem] bg-navy-900 px-4 pb-6 pt-9">
      <div class="absolute left-1/2 top-2.5 h-5 w-20 -translate-x-1/2 rounded-full bg-black"></div>
      <slot />
    </div>
  </div>
</div>
