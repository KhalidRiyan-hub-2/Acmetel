---
// Page section wrapper. tone: 'base' = navy-900, 'raised' = brand navy-800 band, 'glow' = base with teal aurora.
// bg: fade in a fixed background layer while the section is on screen (base/glow tones only; raised is opaque).
interface Props { id?: string; tone?: 'base' | 'raised' | 'glow'; bg?: 'glow' | 'grid'; class?: string; tight?: boolean }
const { id, tone = 'base', bg, class: className = '', tight = false } = Astro.props;
---
<section id={id} data-bg={bg} class:list={['relative', tight ? 'py-12 sm:py-14' : 'py-16 sm:py-20', tone === 'raised' && 'bg-navy-800 border-y border-line', tone === 'glow' && 'overflow-hidden', className]}>
  {tone === 'glow' && (
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
      <div class="absolute left-1/2 top-1/2 h-[36rem] w-[36rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-teal-500/10 blur-3xl"></div>
    </div>
  )}
  <div class="container-x relative"><slot /></div>
</section>
