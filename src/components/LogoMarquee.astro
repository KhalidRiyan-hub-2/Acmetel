---
// Infinite partner marquee. PLACEHOLDER: names rendered as wordmarks until client supplies partner logo files.
interface Props { names: string[] }
const { names } = Astro.props;
---
<div class="relative overflow-hidden [mask-image:linear-gradient(to_right,transparent,#000_12%,#000_88%,transparent)]" aria-label="Partners">
  <ul class="flex w-max animate-marquee gap-4 hover:[animation-play-state:paused]">
    {[...names, ...names].map((n, i) => (
      <li aria-hidden={i >= names.length ? 'true' : undefined} class="grid h-20 min-w-44 place-items-center rounded-2xl border border-line bg-white/[0.03] px-8 font-display text-xl font-semibold tracking-tight text-ink-muted transition-colors hover:text-ink">{n}</li>
    ))}
  </ul>
</div>
