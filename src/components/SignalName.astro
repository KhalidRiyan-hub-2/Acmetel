---
// Brand band: the name drawn by signal threads, with the tagline under it as the real heading.
// A silk ribbon of threads (src/scripts/silk/scene.ts, three.js) flows in as the band enters, then fans out into
// rows that oscillate inside the letters, so the threads spell the name. While the band is on screen it cycles by
// itself (ribbon → name → ribbon …). The canvas also sits in a toggle button (aria-pressed): a click or Enter/Space
// tweens to the other state at once (~2.2 s), mid-tween it reverses from where it is, and the cycle restarts from
// there. The canvas spans the full viewport width.
// three.js loads only when the band nears the viewport and shares the globe's chunk. Reduced motion, no WebGL or
// a lost context: one static settled frame in Canvas 2D (still.ts), and the button is disabled with no hint.
// The canvas is decorative; screen readers get "<word>. <text> <highlight>" from the heading (or just the text with
// srWord={false}, when the heading already contains the word). The default slot renders under the heading (e.g. a lede).
import Section from './Section.astro';

interface Props {
  text: string;
  highlight?: string;
  /** The word the threads spell. */
  word?: string;
  /** Prefix the heading with the word for screen readers (turn off when the heading already says it). */
  srWord?: boolean;
  tone?: 'base' | 'glow';
  bg?: 'glow' | 'grid';
  class?: string;
}
const { text, highlight, word = 'Acmetel', srWord = true, tone = 'glow', bg, class: className = '' } = Astro.props;
---
<Section tone={tone} bg={bg} class:list={['py-20! sm:py-28!', className]}>
  <div class="flex flex-col items-center text-center" data-signal-name data-word={word}>
    <!-- Full-bleed: viewport-wide, centred by the flex column so it overflows the container evenly on both sides
         (the glow Section clips the scrollbar-width excess). -->
    <button type="button" class="signal-toggle block w-screen max-w-none shrink-0 cursor-pointer outline-offset-4 focus-visible:outline-2 focus-visible:outline-teal-400 disabled:cursor-default" aria-pressed="false" aria-label={`Draw “${word}” in signal threads`} disabled data-signal-toggle>
      <canvas class="block aspect-[2/1] w-full sm:aspect-[3/1]" aria-hidden="true"></canvas>
    </button>
    <h2 class="mt-6 max-w-4xl font-display text-[1.65rem] font-semibold leading-[1.15] text-ink sm:mt-8 sm:text-4xl lg:text-5xl">
      {srWord && <span class="sr-only">{word}. </span>}{text}{highlight && <> <span class="text-gradient">{highlight}</span></>}
    </h2>
    <slot />
  </div>
</Section>

<script>
  import { gsap, onVisible, prefersReducedMotion, EASE } from '../scripts/motion';
  import type { Silk } from '../scripts/silk/scene';

  // Probed only when the band is near, on a throwaway canvas whose context is released straight away.
  const hasWebGL = () => {
    try {
      const gl = (document.createElement('canvas').getContext('webgl2') || document.createElement('canvas').getContext('webgl')) as WebGLRenderingContext | null;
      gl?.getExtension('WEBGL_lose_context')?.loseContext();
      return !!gl;
    } catch { return false; }
  };

  document.querySelectorAll<HTMLElement>('[data-signal-name]').forEach((root) => {
    const word = root.dataset.word || 'Acmetel';
    let canvas = root.querySelector('canvas')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-signal-toggle]')!;

    // Static settled frame, redrawn when the width changes. No three.js involved.
    const still = async () => {
      toggle.disabled = true;
      const [{ drawStill }, { fontReady }] = await Promise.all([import('../scripts/silk/still'), import('../scripts/silk/shared')]);
      await fontReady();
      let w = 0;
      new ResizeObserver(() => { if (canvas.clientWidth !== w) { w = canvas.clientWidth; drawStill(canvas, word); } }).observe(canvas);
    };
    // After a WebGL failure the canvas may hold a dead context: draw the still on a fresh copy.
    const fallback = () => {
      const fresh = canvas.cloneNode() as HTMLCanvasElement;
      canvas.replaceWith(fresh);
      canvas = fresh;
      still();
    };

    // Reduced motion: the still is cheap (no three.js), so draw it once the page is idle rather than on approach.
    if (prefersReducedMotion()) {
      const idle = window.requestIdleCallback ?? ((cb: () => void) => setTimeout(cb, 200));
      idle(() => still());
      return;
    }

    // Ribbon ↔ name. One tween at a time: a new change overwrites the running one from the current value.
    // While the band is on screen it cycles by itself (ribbon, then the name, then back); a click toggles at once
    // and restarts the cycle from there.
    const TWEEN = 2.2;                           // s, ribbon ↔ name
    const HOLD = { ribbon: 2500, name: 4500 };   // ms each state stays put after its tween
    const state = { s: 0 };
    let silk: Silk | null = null, revealed = false, inView = false, timer = 0;
    toggle.disabled = false;
    const set = (v: boolean) => {
      revealed = v;
      toggle.setAttribute('aria-pressed', String(revealed));
      gsap.to(state, {
        s: revealed ? 1 : 0, duration: TWEEN, ease: EASE.inOut, overwrite: true,
        onUpdate: () => silk?.settle(state.s),
      });
    };
    // `wait` overrides the delay (entering view: the first change comes soon, not after a full hold).
    const schedule = (wait?: number) => {
      clearTimeout(timer);
      if (!inView) return;
      timer = window.setTimeout(() => { set(!revealed); schedule(); }, wait ?? TWEEN * 1000 + (revealed ? HOLD.name : HOLD.ribbon));
    };
    toggle.addEventListener('click', () => { set(!revealed); schedule(); });
    new IntersectionObserver(([e]) => {
      const entering = e.isIntersecting && !inView;
      inView = e.isIntersecting;
      schedule(entering ? 1200 : undefined);
    }, { threshold: 0.35 }).observe(toggle);

    onVisible(canvas, async () => {
      if (!hasWebGL()) { still(); return; } // no three.js download without WebGL
      try {
        const [{ initSilk }, { fontReady }] = await Promise.all([import('../scripts/silk/scene'), import('../scripts/silk/shared')]);
        await fontReady();
        silk = initSilk(canvas, { word, settle: state.s, onLost: () => { silk = null; fallback(); } });
      } catch {
        silk = null;
        fallback();
      }
    }, '400px');
  });
</script>
