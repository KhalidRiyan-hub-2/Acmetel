---
// Stylised message-path panel for the Messaging hero. Decorative only; no data claims.
import Icon from '../Icon.astro';
const steps = [
  { icon: 'building', label: 'Enterprise' },
  { icon: 'shield', label: 'Firewall' },
  { icon: 'smartphone', label: 'Subscriber' },
] as const;
---
<div aria-hidden="true" class="relative mx-auto w-full max-w-md">
  <div class="absolute -inset-8 rounded-full bg-teal-500/15 blur-3xl"></div>
  <div class="glass relative p-6 sm:p-7">
    <div class="flex items-center justify-between">
      <p class="eyebrow">Message path</p>
      <span class="inline-flex items-center gap-2 text-sm text-ink-muted"><Icon name="lock" size={16} class="text-teal-400" />Secured</span>
    </div>

    <ol class="relative mt-7 grid grid-cols-3 gap-2">
      <svg viewBox="0 0 300 4" preserveAspectRatio="none" class="absolute left-[16%] top-6 h-1 w-[68%]" fill="none">
        <line x1="0" y1="2" x2="300" y2="2" class="animate-dash stroke-teal-400" stroke-width="2" stroke-dasharray="10 14" stroke-linecap="round" />
      </svg>
      {steps.map((s) => (
        <li class="relative flex flex-col items-center text-center">
          <span class="grid size-12 place-items-center rounded-xl border border-teal-500/30 bg-navy-800 text-teal-300"><Icon name={s.icon} /></span>
          <span class="mt-3 text-sm text-ink-muted">{s.label}</span>
        </li>
      ))}
    </ol>

    <div class="mt-7 space-y-3">
      <div class="flex items-center gap-3 rounded-2xl rounded-bl-md border border-line bg-white/[0.04] px-4 py-3 text-sm text-ink">
        <Icon name="message" size={18} class="shrink-0 text-teal-400" />A2P · OTP, transactional, promotional
      </div>
      <div class="ml-auto flex w-fit items-center gap-3 rounded-2xl rounded-br-md bg-gradient-to-br from-teal-500 to-green-700 px-4 py-3 text-sm font-medium text-navy-950">
        <Icon name="messages" size={18} class="shrink-0" />P2A · two-way replies
      </div>
      <div class="flex items-center gap-3 rounded-2xl rounded-bl-md border border-line bg-white/[0.04] px-4 py-3 text-sm text-ink">
        <Icon name="fingerprint" size={18} class="shrink-0 text-teal-400" />Silent network authentication
      </div>
    </div>
  </div>
</div>
