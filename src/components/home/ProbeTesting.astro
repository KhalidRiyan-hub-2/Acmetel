---
// Homepage Probe Testing section, under the "Products for operators" band. Text verbatim from
// content/source/messaging.md "Network Penetration Testing (NPT)" (lede + four of its bullets).
// Same treatment as SmsFirewall: heading and CTA on the left, the bullets on the right, code rain behind the band.
import Section from '../Section.astro';
import SectionHeading from '../SectionHeading.astro';
import SplitSection from '../SplitSection.astro';
import CheckList from '../CheckList.astro';
import Button from '../Button.astro';

interface Props { id?: string; tone?: 'base' | 'raised' | 'glow' }
const { id = 'probe-testing', tone = 'base' } = Astro.props;

const bullets = [
  'SMS route penetration testing',
  'Grey route identification',
  'International traffic bypass analysis',
  'SIM box detection',
];
---
<Section id={id} tone={tone} rain>
  <SplitSection>
    <SectionHeading eyebrow="Probe Testing" title="Network" highlight="penetration testing" lede="Identify vulnerabilities before fraudsters do through comprehensive telecom security testing." />
    <div class="mt-8"><Button href="/services/messaging#penetration-testing" variant="outline">Explore Probe Testing</Button></div>
    <CheckList slot="visual" items={bullets} />
  </SplitSection>
</Section>
