---
// Homepage Fraud Management section. Text verbatim from content/source/voice.md
// "Fraud Management & Revenue Assurance" (lede + the four features).
// Same treatment as SmsFirewall: heading and CTA on the left, the features on the right, code rain behind the band.
import Section from '../Section.astro';
import SectionHeading from '../SectionHeading.astro';
import SplitSection from '../SplitSection.astro';
import CheckList from '../CheckList.astro';
import Button from '../Button.astro';

interface Props { id?: string; tone?: 'base' | 'raised' | 'glow' }
const { id = 'fraud-management-home', tone = 'base' } = Astro.props;

const features = ['Real-time fraud detection', 'Intelligent automation', 'Test call generation', 'Revenue leakage prevention'];
---
<Section id={id} tone={tone} rain>
  <SplitSection>
    <SectionHeading eyebrow="Fraud Management" title="Fraud management &" highlight="revenue assurance" lede="Protect your network and revenue streams with advanced fraud detection technologies." />
    <div class="mt-8"><Button href="/services/voice#fraud-management" variant="outline">Explore Fraud Management</Button></div>
    <CheckList slot="visual" items={features} />
  </SplitSection>
</Section>
