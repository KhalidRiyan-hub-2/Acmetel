---
// Home hero visual: interactive WebGL globe (Three.js, lazy-loaded) over a static fallback image.
// The box is reserved up front (no layout shift) and sized so the whole globe always fits the viewport.
// The static image stays when reduced motion is on or WebGL is unavailable.
// Zoom destinations form a tree (src/data/globe.ts): breadcrumbs show where you are, chips show where you
// can go next; tapping the map or wheel/pinch (once focused) move through the same tree.
import PauseButton from '../PauseButton.astro';
import { stops, tags, childrenOf, type Tag } from '../../data/globe';

interface Props { class?: string }
const { class: className = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const coord = (lat: number, lon: number) => `${Math.abs(lat).toFixed(2)}°${lat >= 0 ? 'N' : 'S'} ${Math.abs(lon).toFixed(2)}°${lon >= 0 ? 'E' : 'W'}`;
const startChips = childrenOf('global');
// "Jump to" row: every country stop and every Acmetel office, minus what the current view already offers.
const jumpStart = stops.filter((s) => s.office);
// Which label wins when two overlap on screen (lower first; the scene fades the other out).
const rank: Record<Tag['kind'], number> = { office: 0, landmark: 1, pill: 2, 'city-major': 3, country: 4, waypoint: 5, district: 6, city: 7 };
---
<div data-globe-hero data-live="false" data-data={`${base}/data`} data-stops={JSON.stringify(stops.map(({ id, label, parent, caption, office }) => ({ id, label, parent, caption, office: !!office })))}
  class:list={['globe-hero group/globe relative mx-auto w-full', className]}>
  <div class="globe-box relative mx-auto aspect-square" data-globe-box>
    <div class="absolute inset-0">
      <p class="sr-only">Globe showing links from Acmetel's headquarters in Ras Al Khaimah, UAE, to Lahore, Pakistan and to Acmetel USA in Illinois, along with the core network in Pakistan, the Pakistan–China terrestrial fiber route, and markets in the Gulf, Africa and the UK. Use the location controls below the globe to zoom.</p>

      <div data-globe-stage aria-hidden="true" class="absolute inset-0">
        <img data-globe-img src={`${base}/images/globe-fallback.webp`} width="800" height="800" alt="" loading="eager" fetchpriority="high" decoding="async"
          class="absolute inset-0 size-full select-none object-contain transition-opacity duration-700" />
      </div>

      <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
        {tags.map((t) => (
          <div data-globe-tag data-lat={t.lat} data-lon={t.lon} data-z0={t.z[0]} data-z1={t.z[1]} data-near={t.near ?? ''} data-h={t.h ?? ''} data-rank={rank[t.kind]}
            data-clamp={t.kind === 'office' ? '' : undefined} class={`globe-tag globe-tag-${t.kind}`}>
            {t.kind === 'pill' && (<>
              <span class="absolute left-2.5 -top-4 h-4 w-px bg-teal-400/60"></span>
              <span class="absolute -top-[2.7rem] left-2.5 whitespace-nowrap rounded-full border border-teal-500/40 bg-navy-950/80 px-3 py-1 font-mono text-[0.7rem] tracking-wide text-teal-300 backdrop-blur">{t.text}</span>
            </>)}
            {t.kind === 'country' && <span class="absolute -translate-x-1/2 -translate-y-1/2 whitespace-nowrap font-mono text-[0.62rem] uppercase tracking-[0.34em] text-ink/80">{t.text}</span>}
            {t.kind === 'city-major' && (<>
              <span class="absolute left-0 -top-8 h-8 w-px bg-gradient-to-t from-teal-300/80 to-transparent"></span>
              <span class="absolute -top-[3.1rem] right-2 whitespace-nowrap text-right">
                <span class="block font-display text-sm font-semibold text-ink">{t.text}</span>
                <span class="block font-mono text-[0.6rem] tracking-[0.12em] text-teal-300">{coord(t.lat, t.lon)}</span>
              </span>
            </>)}
            {t.kind === 'city' && <span class="absolute left-2 -top-2 whitespace-nowrap font-mono text-[0.62rem] tracking-wide text-ink-muted">{t.text}</span>}
            {t.kind === 'waypoint' && <span class="absolute left-2.5 -top-2 whitespace-nowrap font-mono text-[0.6rem] uppercase tracking-[0.16em] text-teal-300/90">{t.text}</span>}
            {t.kind === 'district' && <span class="absolute -translate-x-1/2 -translate-y-1/2 whitespace-nowrap font-mono text-[0.58rem] uppercase tracking-[0.2em] text-ink/85 [text-shadow:0_0_2px_var(--color-navy-950),0_0_8px_var(--color-navy-950)]">{t.text}</span>}
            {t.kind === 'landmark' && (<>
              <span class="absolute left-0 -top-10 h-10 w-px bg-gradient-to-t from-teal-300/80 to-transparent"></span>
              <span class="absolute -top-[3.4rem] left-2 whitespace-nowrap">
                <span class="block font-display text-sm font-semibold text-ink [text-shadow:0_0_8px_var(--color-navy-950)]">{t.text}</span>
                <span class="block font-mono text-[0.6rem] tracking-[0.12em] text-teal-300">{t.sub}</span>
              </span>
            </>)}
            {t.kind === 'office' && (<>
              <span class="absolute left-0 -top-12 h-12 w-px bg-teal-300/70 max-sm:-top-8 max-sm:h-8"></span>
              <span class="globe-office-card absolute bottom-12 left-0 max-sm:bottom-8 whitespace-nowrap rounded-md border border-teal-400/50 bg-navy-950/85 px-2.5 py-1.5 text-center backdrop-blur">
                <span class="block font-mono text-[0.56rem] uppercase tracking-[0.18em] text-teal-300">{t.kicker}</span>
                <span class="block font-display text-sm font-semibold leading-tight text-ink">{t.text}</span>
                <span class="block font-mono text-[0.6rem] tracking-[0.06em] text-ink-muted">{t.sub}</span>
              </span>
            </>)}
          </div>
        ))}
      </div>

      <p data-globe-readout aria-hidden="true" class="pointer-events-none absolute left-0 top-1 hidden rounded-md bg-navy-950/75 px-2 py-1 font-mono text-[0.625rem] uppercase leading-relaxed tracking-[0.14em] text-ink-muted tabular-nums backdrop-blur-sm group-data-[live=true]/globe:block">
        <span data-ro-lat>30.40°N</span> <span data-ro-lon>69.30°E</span><br /><span class="text-teal-400/80">Alt</span> <span data-ro-alt>24,200 km</span>
      </p>

      <span data-globe-hint data-show="false" aria-hidden="true"
        class="pointer-events-none absolute right-0 top-1 whitespace-nowrap rounded-full border border-line-strong bg-navy-900/80 px-3 py-1 text-xs text-ink-muted opacity-0 backdrop-blur transition-opacity duration-300 data-[show=true]:opacity-100 max-sm:hidden">Click to focus, then scroll to zoom</span>

      <p data-globe-osm data-show="false" class="absolute bottom-1 left-0 font-mono text-[0.6rem] text-ink-faint opacity-0 transition-opacity duration-300 data-[show=false]:pointer-events-none data-[show=true]:opacity-100">
        © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener" class="underline-offset-2 hover:text-ink hover:underline" tabindex="-1" data-globe-osm-link>OpenStreetMap contributors</a>
      </p>

      <div class="absolute bottom-1 right-1 hidden group-data-[live=true]/globe:block">
        <PauseButton />
      </div>
    </div>
  </div>

  <!-- Location controls. Reserved in the layout so they never shift; hidden entirely when the globe can't run. -->
  <div data-globe-controls class="globe-controls mx-auto mt-4 flex max-w-xl flex-col items-center gap-3 text-center">
    <nav aria-label="Globe location">
      <ol class="flex min-h-7 flex-wrap items-center justify-center gap-x-1 gap-y-1 font-mono text-[0.7rem] uppercase tracking-[0.16em]" data-globe-crumbs>
        <li><span aria-current="location" class="px-2 py-1 text-ink">Global</span></li>
      </ol>
    </nav>
    <div role="toolbar" aria-label="Zoom to" class="flex min-h-9 max-w-full justify-center-safe gap-2 overflow-x-auto px-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" data-globe-next>
      {startChips.map((s, i) => (
        <button type="button" data-go={s.id} tabindex={i === 0 ? 0 : -1} class="globe-chip" data-office={s.office ? 'true' : undefined}>{s.label}</button>
      ))}
    </div>
    <!-- Jump anywhere (other countries and the Acmetel offices) without stepping back; the scene flies there directly. -->
    <div role="toolbar" aria-label="Jump to" class="flex min-h-8 max-w-full items-center justify-center-safe gap-1.5 overflow-x-auto px-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" data-globe-jump>
      <span class="globe-jump-label" aria-hidden="true">Jump to</span>
      {jumpStart.map((s, i) => (
        <button type="button" data-go={s.id} tabindex={i === 0 ? 0 : -1} class="globe-chip globe-chip-jump" data-office={s.office ? 'true' : undefined}>{s.label}</button>
      ))}
    </div>
    <p data-globe-caption aria-live="polite" class="min-h-[4rem] max-w-md text-sm leading-snug text-ink-muted sm:min-h-[2.75rem]">{stops[0].caption}</p>
  </div>
</div>

<style>
  /* Sits beside the headline; the whole globe always fits the viewport (svh: stable when mobile browser bars move). */
  .globe-box { width: min(100%, 36rem, calc(100svh - 9.5rem)); }
  .globe-tag { position: absolute; left: 0; top: 0; opacity: 0; visibility: hidden; will-change: transform, opacity; }
  .globe-tag-city::before, .globe-tag-waypoint::before {
    content: ""; position: absolute; left: -2px; top: -2px; width: 4px; height: 4px; border-radius: 9999px;
    background: var(--color-ink); box-shadow: 0 0 0 2px rgb(14 19 34 / 0.6);
  }
  .globe-tag-waypoint::before { background: var(--color-teal-300); }
  /* Flipped (set by the scene near the right edge): text sits left of its point. */
  .globe-tag-city[data-flip='true'] > span, .globe-tag-waypoint[data-flip='true'] > span { left: auto !important; right: 0.5rem; }
  .globe-tag-landmark::before {
    content: ""; position: absolute; left: -3px; top: -3px; width: 6px; height: 6px; border-radius: 9999px;
    background: var(--color-teal-300); box-shadow: 0 0 10px var(--color-teal-300);
  }
  .globe-tag-landmark[data-flip='true'] > span:last-child { left: auto !important; right: 0.5rem; text-align: right; }
  /* Acmetel office: a teal diamond on a solid stem and a boxed label, so offices never read as geography. */
  .globe-tag-office::before {
    content: ""; position: absolute; left: -4px; top: -4px; width: 8px; height: 8px; transform: rotate(45deg);
    background: var(--color-teal-300); box-shadow: 0 0 0 3px rgb(14 19 34 / 0.7), 0 0 14px var(--color-teal-300);
  }
  /* Centred over its stem; the scene sets --dx to keep it inside the globe box near the edges. */
  .globe-office-card { transform: translateX(calc(-50% + var(--dx, 0px))); }
  .globe-tag-pill[data-flip='true'] > span { left: auto !important; }
  .globe-tag-pill[data-flip='true'] > span:first-child { right: auto; left: 0.625rem !important; }
  .globe-tag-pill[data-flip='true'] > span:last-child { right: -0.625rem; }
  :global(.globe-chip) {
    flex: none; border-radius: 9999px; border: 1px solid var(--color-line-strong); background: rgb(14 19 34 / 0.6);
    padding: 0.4rem 0.9rem; font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--color-ink-muted); transition: color 200ms, border-color 200ms, background-color 200ms; cursor: pointer;
  }
  :global(.globe-chip:hover), :global(.globe-chip:focus-visible) { color: var(--color-ink); border-color: rgb(76 198 189 / 0.6); }
  /* Office stops: teal outline and a diamond, matching the office tag on the globe. */
  :global(.globe-chip[data-office]) { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--color-teal-300); border-color: rgb(76 198 189 / 0.45); }
  :global(.globe-chip[data-office])::before { content: ""; width: 0.4rem; height: 0.4rem; transform: rotate(45deg); background: currentColor; }
  [data-globe-crumbs] :global(span[data-office]) { color: var(--color-teal-300); }
  /* "Jump to" chips: quieter than the zoom-deeper row, so the two levels of choice read apart. */
  :global(.globe-chip-jump) { padding: 0.3rem 0.7rem; font-size: 0.64rem; background: transparent; border-color: var(--color-line); color: var(--color-ink-faint); }
  :global(.globe-chip-jump[data-office]) { color: rgb(127 220 213 / 0.8); border-color: rgb(76 198 189 / 0.3); }
  .globe-jump-label { flex: none; padding-right: 0.25rem; font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-ink-faint); }
  :global(.globe-crumb) { border-radius: 9999px; padding: 0.25rem 0.5rem; color: var(--color-ink-faint); transition: color 200ms; cursor: pointer; }
  :global(.globe-crumb:hover), :global(.globe-crumb:focus-visible) { color: var(--color-teal-300); }
  [data-globe-crumbs] :global(li + li)::before { content: "›"; margin-right: 0.25rem; color: var(--color-ink-faint); }
  /* No WebGL / context lost / reduced motion: the static image has nothing to drive. */
  [data-globe-hero][data-static] .globe-controls { display: none; }
  @media (prefers-reduced-motion: reduce) { .globe-controls { display: none; } }
</style>

<script>
  import { onVisible, prefersReducedMotion } from '../../scripts/motion';

  const root = document.querySelector<HTMLElement>('[data-globe-hero]');
  if (root) {
    type S = { id: string; label: string; parent: string | null; caption: string; office: boolean };
    const stops: S[] = JSON.parse(root.dataset.stops!);
    const byId = Object.fromEntries(stops.map((s) => [s.id, s])) as Record<string, S>;
    const pathTo = (id: string) => { const out: S[] = []; for (let s: S | undefined = byId[id]; s; s = s.parent ? byId[s.parent] : undefined) out.unshift(s); return out; };
    const kidsOf = (id: string) => stops.filter((s) => s.parent === id);

    const stage = root.querySelector<HTMLElement>('[data-globe-stage]')!;
    const img = root.querySelector<HTMLImageElement>('[data-globe-img]')!;
    const hint = root.querySelector<HTMLElement>('[data-globe-hint]');
    const pauseBtn = root.querySelector<HTMLButtonElement>('[data-pause]');
    const crumbs = root.querySelector<HTMLElement>('[data-globe-crumbs]')!;
    const next = root.querySelector<HTMLElement>('[data-globe-next]')!;
    const jump = root.querySelector<HTMLElement>('[data-globe-jump]')!;
    const jumpLabel = jump.querySelector('.globe-jump-label')!;
    const caption = root.querySelector<HTMLElement>('[data-globe-caption]')!;
    const osm = root.querySelector<HTMLElement>('[data-globe-osm]')!;
    const osmLink = root.querySelector<HTMLElement>('[data-globe-osm-link]')!;
    const ro = {
      lat: root.querySelector<HTMLElement>('[data-ro-lat]')!,
      lon: root.querySelector<HTMLElement>('[data-ro-lon]')!,
      alt: root.querySelector<HTMLElement>('[data-ro-alt]')!,
    };
    const tags = [...root.querySelectorAll<HTMLElement>('[data-globe-tag]')].map((el) => ({
      el, lat: Number(el.dataset.lat), lon: Number(el.dataset.lon), z: [Number(el.dataset.z0), Number(el.dataset.z1)] as const,
      near: el.dataset.near ? Number(el.dataset.near) : undefined,
      h: el.dataset.h ? Number(el.dataset.h) : undefined,
      rank: Number(el.dataset.rank),
    }));

    let api: { flyTo(id: string): void } | null = null;
    let pending: string | null = null;
    const go = (id: string) => { if (api) api.flyTo(id); else pending = id; };

    // --- Breadcrumb + "zoom to" chips -----------------------------------------------------------
    // The trail shows the destination as soon as a flight starts; the caption updates on arrival.
    let shown = '';
    const renderNav = (id: string) => {
      if (id === shown) return;
      const hadFocus = root.contains(document.activeElement) && (crumbs.contains(document.activeElement) || next.contains(document.activeElement) || jump.contains(document.activeElement));
      shown = id;
      const trail = pathTo(id);
      crumbs.replaceChildren(...trail.map((s, i) => {
        const li = document.createElement('li');
        if (i === trail.length - 1) {
          const span = document.createElement('span');
          span.className = 'px-2 py-1 text-ink';
          if (s.office) span.dataset.office = 'true';
          span.setAttribute('aria-current', 'location');
          span.textContent = s.label;
          li.append(span);
        } else {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'globe-crumb';
          b.dataset.go = s.id;
          b.textContent = s.label;
          li.append(b);
        }
        return li;
      }));
      // Where you can go next: children, or for a leaf its siblings.
      const here = byId[id];
      const options = kidsOf(id).length ? kidsOf(id) : here.parent ? kidsOf(here.parent).filter((s) => s.id !== id) : [];
      const chip = (s: S, i: number, extra = '') => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = `globe-chip${extra}`;
        b.dataset.go = s.id;
        if (s.office) b.dataset.office = 'true';
        b.tabIndex = i === 0 ? 0 : -1;
        b.textContent = s.label;
        return b;
      };
      next.replaceChildren(...options.map((s, i) => chip(s, i)));
      // Jump anywhere: the other countries and the Acmetel offices, minus the current trail and the row above.
      const skip = new Set([...trail.map((s) => s.id), ...options.map((s) => s.id)]);
      const jumps = stops.filter((s) => (s.parent === 'global' || s.office) && !skip.has(s.id));
      jump.replaceChildren(jumpLabel, ...jumps.map((s, i) => chip(s, i, ' globe-chip-jump')));
      jump.hidden = jumps.length === 0;
      // Keep keyboard users in the controls after the list changes.
      if (hadFocus) (next.querySelector<HTMLElement>('[tabindex="0"]') ?? crumbs.querySelector<HTMLElement>('button'))?.focus({ preventScroll: true });
    };
    root.addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLElement>('[data-go]');
      if (b && root.contains(b)) go(b.dataset.go!);
    });
    // Roving focus in each chip toolbar.
    for (const bar of [next, jump]) bar.addEventListener('keydown', (e) => {
      const items = [...bar.querySelectorAll<HTMLElement>('button')];
      const i = items.indexOf(document.activeElement as HTMLElement);
      if (i < 0) return;
      const k = { ArrowRight: i + 1, ArrowDown: i + 1, ArrowLeft: i - 1, ArrowUp: i - 1, Home: 0, End: items.length - 1 }[e.key];
      if (k === undefined) return;
      e.preventDefault();
      const j = (k + items.length) % items.length;
      items.forEach((b, n) => { b.tabIndex = n === j ? 0 : -1; });
      items[j].focus();
    });

    const fmt = (v: number, pos: string, neg: string) => `${Math.abs(v).toFixed(2)}°${v >= 0 ? pos : neg}`;
    const hasWebGL = (() => {
      try {
        const c = document.createElement('canvas');
        const gl = (c.getContext('webgl2') || c.getContext('webgl')) as WebGLRenderingContext | null;
        gl?.getExtension('WEBGL_lose_context')?.loseContext();
        return !!gl;
      } catch { return false; }
    })();
    const reduced = prefersReducedMotion();

    // --- Globe -------------------------------------------------------------------------------------
    // Start the 3D globe on the visitor's first interaction rather than at load. The static image is the
    // same view, so the hand-off is invisible, and the three.js chunk plus its render loop stay off
    // the critical path (this is what keeps mobile Lighthouse Performance in the 90s).
    const afterFirstInteraction = (cb: () => void) => {
      const events = ['pointermove', 'pointerdown', 'scroll', 'keydown', 'touchstart', 'wheel'] as const;
      const run = () => { events.forEach((e) => removeEventListener(e, run)); cb(); };
      events.forEach((e) => addEventListener(e, run, { once: true, passive: true }));
    };

    if (!hasWebGL || reduced) {
      root.dataset.static = '';
    } else {
      afterFirstInteraction(() => onVisible(root, async () => {
        try {
          const { initGlobe } = await import('../../scripts/globe/scene');
          root.dataset.live = 'true';
          const g = initGlobe(stage, {
            dataUrl: root.dataset.data!,
            tags, hint, pauseButton: pauseBtn,
            onTarget: (id) => renderNav(id),
            onState: (s) => {
              if (s.stop) { renderNav(s.stop); if (caption.textContent !== byId[s.stop].caption) caption.textContent = byId[s.stop].caption; }
              ro.lat.textContent = fmt(s.lat, 'N', 'S');
              ro.lon.textContent = fmt(s.lon, 'E', 'W');
              ro.alt.textContent = s.altKm < 10 ? `${Math.round(s.altKm * 1000).toLocaleString('en-US')} m` : `${s.altKm.toLocaleString('en-US')} km`;
              osm.dataset.show = String(s.osm);
              osmLink.tabIndex = s.osm ? 0 : -1;
            },
            onFirstFrame: () => { img.style.opacity = '0'; },
            onContextLost: () => { img.style.opacity = '1'; root.dataset.live = 'false'; root.dataset.static = ''; },
          });
          api = g;
          if (pending) g.flyTo(pending);
        } catch {
          root.dataset.live = 'false';
          root.dataset.static = '';
        }
      }));
    }
  }
</script>
