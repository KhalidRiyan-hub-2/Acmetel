---
// Homepage SMS Firewall section (docs/agents/QUEUE.md J05). Text verbatim from
// content/source/messaging.md "Firewall & Security Solutions" (lede + four of its bullets).
// Heading and CTA on the left, the bullets on the right, with code rain behind the band (Section rain).
import Section from '../Section.astro';
import SectionHeading from '../SectionHeading.astro';
import SplitSection from '../SplitSection.astro';
import CheckList from '../CheckList.astro';
import Button from '../Button.astro';

interface Props { id?: string; tone?: 'base' | 'raised' | 'glow'; rain?: boolean }
const { id = 'sms-firewall', tone = 'base', rain = true } = Astro.props;

const bullets = [
  'SMS, Voice, and Flash Call firewall deployment',
  'Grey route and international bypass prevention',
  'AI-powered fraud detection and traffic filtering',
  'Real-time analytics and threat intelligence',
];
---
<Section id={id} tone={tone} rain={rain}>
  <SplitSection>
    <SectionHeading eyebrow="SMS Firewall" title="Firewall &" highlight="security solutions" lede="Protect operator networks while maximizing international messaging revenues through AI-driven security and monetization platforms." />
    <div class="mt-8"><Button href="/services/messaging#firewall" variant="outline">Explore SMS Firewall</Button></div>
    <CheckList slot="visual" items={bullets} />
  </SplitSection>
</Section>
