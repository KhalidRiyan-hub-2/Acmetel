---
// Three-step purchase journey with a small phone mockup per step. Screens are illustrative UI, not real app captures.
import PhoneMockup from '../PhoneMockup.astro';
import Icon from '../Icon.astro';
const steps = [
  { n: '01', title: 'Choose your destination', text: 'Pick where you are headed.' },
  { n: '02', title: 'Select your data plan', text: 'Prepaid plans with full control over usage.' },
  { n: '03', title: 'Install your eSIM instantly', text: 'One tap. No QR codes, no physical SIM.' },
];
// PLACEHOLDER: destinations and plan sizes below are illustrative mock UI, not real ACMeSIM plans or prices.
const destinations = ['United Kingdom', 'United Arab Emirates', 'Japan', 'Türkiye'];
const plans = ['5 GB', '10 GB', '20 GB'];
---
<div class="relative" data-stagger>
  <div aria-hidden="true" class="absolute left-[16%] right-[16%] top-6 hidden border-t border-dashed border-teal-500/40 lg:block"></div>
  <ol class="grid gap-14 lg:grid-cols-3 lg:gap-8">
    {steps.map((s, i) => (
      <li class="relative flex flex-col items-center text-center">
        <span class="relative z-10 mb-6 grid size-12 place-items-center rounded-full bg-gradient-to-br from-teal-400 to-green-700 font-display text-sm font-bold text-navy-950 shadow-[0_0_28px_-4px_rgb(34_170_161/0.8)]">{s.n}</span>
        <PhoneMockup tilt={false} class="!w-52">
          {i === 0 && (
            <div class="min-h-[18rem]">
              <p class="text-xs text-ink-faint">Where to?</p>
              <div class="mt-2 flex items-center gap-2 rounded-xl border border-line-strong bg-white/[0.04] px-3 py-2 text-xs text-ink-muted"><Icon name="search" size={14} />Search destination</div>
              <div class="mt-3 space-y-2">
                {destinations.map((d, j) => (
                  <div class:list={['flex items-center justify-between rounded-xl border px-3 py-2.5 text-xs text-ink', j === 0 ? 'border-teal-400 bg-teal-500/10' : 'border-line bg-white/[0.03]']}>
                    <span class="flex items-center gap-2"><Icon name="map-pin" size={14} class="text-teal-400" />{d}</span>
                  </div>
                ))}
              </div>
            </div>
          )}
          {i === 1 && (
            <div class="min-h-[18rem]">
              <p class="text-xs text-ink-faint">United Kingdom</p>
              <p class="font-display text-base font-semibold text-ink">Select your plan</p>
              <div class="mt-3 space-y-2">
                {plans.map((p, j) => (
                  <div class:list={['flex items-center justify-between rounded-xl border px-3 py-3 text-xs', j === 1 ? 'border-teal-400 bg-teal-500/10 text-ink' : 'border-line bg-white/[0.03] text-ink-muted']}>
                    <span class="font-display text-sm font-semibold">{p}</span>
                    <span class:list={['grid size-4 place-items-center rounded-full border', j === 1 ? 'border-teal-400 bg-teal-400 text-navy-950' : 'border-line-strong']}>{j === 1 && <Icon name="check" size={10} />}</span>
                  </div>
                ))}
              </div>
              <div class="mt-4 rounded-full bg-teal-500 py-2.5 text-center text-xs font-semibold text-navy-950">Continue</div>
            </div>
          )}
          {i === 2 && (
            <div class="min-h-[18rem]">
              <div class="mx-auto mt-2 grid size-16 place-items-center rounded-full bg-gradient-to-br from-teal-500 to-green-700 text-navy-950 shadow-[0_0_32px_-4px_rgb(34_170_161/0.8)]"><Icon name="check" size={32} /></div>
              <p class="mt-4 text-center font-display text-base font-semibold text-ink">eSIM installed</p>
              <p class="mt-1 text-center text-xs text-ink-muted">You are connected.</p>
              <div class="mt-5 space-y-2">
                {['5G connected', 'Hotspot ready'].map((t) => (
                  <div class="flex items-center justify-between rounded-xl border border-line bg-white/[0.03] px-3 py-2.5 text-xs text-ink"><span>{t}</span><span class="size-2 rounded-full bg-teal-400"></span></div>
                ))}
              </div>
            </div>
          )}
        </PhoneMockup>
        <h3 class="mt-8 text-lg font-semibold text-ink">{s.title}</h3>
        <p class="mt-2 max-w-xs text-sm text-ink-muted">{s.text}</p>
      </li>
    ))}
  </ol>
</div>
