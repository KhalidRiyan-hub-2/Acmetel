---
// Stats strip. `value` is numeric; `prefix`/`suffix` wrap it (e.g. suffix "B+").
// Default: count-up (Base.astro animates [data-count]).
// `matrix` (homepage hero only): the "rain lock" intro, src/scripts/statrain.ts, loaded by patterns.ts from
// [data-stat-rain]. Each character is a slot: an invisible copy of the final character sizes it and the live glyph is
// overlaid, so the strip never reflows. Screen readers always get the plain figure; with reduced motion or no JS the
// figures are simply there.
interface Stat { value: number; prefix?: string; suffix?: string; label: string }
// `mask` (homepage hero): the figures are hidden until the pointer moves over the strip, where a blob-shaped mask
// follows the cursor and reveals them (src/scripts/svgmask.ts, [data-svg-mask]). The real <dl> stays in the DOM; the
// revealed copy is aria-hidden. Touch, reduced motion and no-JS show the figures plainly.
interface Props { stats: Stat[]; matrix?: boolean; mask?: boolean; class?: string }
const { stats, matrix = false, mask = false, class: className = '' } = Astro.props;
const lgCols = { 2: 'lg:grid-cols-2', 3: 'lg:grid-cols-3', 4: 'lg:grid-cols-4', 5: 'lg:grid-cols-5', 6: 'lg:grid-cols-6' }[Math.min(Math.max(stats.length, 2), 6)];
const figure = (s: Stat) => `${s.prefix ?? ''}${s.value}${s.suffix ?? ''}`;
---
{mask ? (
  <div class:list={['svg-mask relative', className]} data-svg-mask>
    <dl class:list={['mask-base relative grid grid-cols-2 gap-x-8 text-center', lgCols]}>
      {stats.map((s, i) => (
        <div class="py-6 sm:py-7">
          <dt class="text-sm text-ink-muted">{s.label}</dt>
          <dd class="relative mt-2 font-display text-3xl font-semibold tabular-nums text-ink sm:text-4xl">
            {figure(s)}<span class="mask-dot" aria-hidden="true" style={`--d:${i * 0.35}s`}></span>
          </dd>
        </div>
      ))}
    </dl>
    <!-- Bleeds 10rem past the strip (padding puts the figures back in place) so the blob is never cut flat. -->
    <div class="mask-reveal pointer-events-none absolute -inset-40 bg-teal-400 p-40" aria-hidden="true" data-mask-reveal>
      <dl class:list={['grid grid-cols-2 gap-x-8 text-center', lgCols]}>
        {stats.map((s) => (
          <div class="py-6 sm:py-7">
            <dt class="text-sm font-medium text-navy-950">{s.label}</dt>
            <dd class="mt-2 font-display text-3xl font-semibold tabular-nums text-navy-950 sm:text-4xl">
              {s.prefix}<span data-count-to={s.value}>{s.value}</span>{s.suffix}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
) : matrix ? (
  <div class:list={['relative', className]} data-stat-rain>
    <!-- No box: the figures sit on the hero, and the rain fades out towards every edge instead of ending at a border. -->
    <canvas class="stat-rain-canvas pointer-events-none absolute inset-0 size-full" aria-hidden="true"></canvas>
    <dl class:list={['relative grid grid-cols-2 gap-x-8', lgCols]}>
      {stats.map((s) => (
        <div class="py-6 sm:py-7" data-cell>
          <dt class="text-sm text-ink-muted">{s.label}</dt>
          <dd class="mt-2 font-display text-3xl font-semibold tabular-nums text-ink sm:text-4xl">
            <span class="sr-only">{figure(s)}</span>
            <span aria-hidden="true" class="select-none">{[...figure(s)].map((c) => (
              <span class="slot" data-final={c}><span class="slot-size">{c}</span><span class="slot-live" data-live>{c}</span></span>
            ))}</span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
) : (
  <dl class:list={['grid grid-cols-2 overflow-hidden rounded-2xl border border-line bg-navy-900', lgCols, className]} data-stagger>
    {stats.map((s) => (
      <div class="px-5 py-7 sm:px-7">
        <dt class="text-sm text-ink-muted">{s.label}</dt>
        <dd class="mt-2 font-display text-3xl font-semibold tabular-nums text-ink sm:text-4xl">
          {s.prefix}<span data-count={s.value} data-suffix={s.suffix ?? ''}>{s.value}{s.suffix}</span>
        </dd>
      </div>
    ))}
  </dl>
)}

<style>
  /* Pre-state (the `motion` class is set in <head>; fine pointer only): base copy fully hidden, reveal copy (navy
     figures on a teal fill) masked to a blob that follows the cursor. Size 0 until svgmask.ts sets --mask-size, so
     nothing shows before the pointer arrives. */
  .mask-reveal, .mask-dot { display: none; }
  @media (hover: hover) and (pointer: fine) {
    :global(.motion) .svg-mask { cursor: crosshair; }
    /* Text made transparent (not opacity 0) so the dot inside each figure stays visible, centred on the number. */
    :global(.motion) .svg-mask .mask-base :is(dt, dd) { color: transparent; }
    /* A blinking teal dot marks where each hidden figure sits; the teal reveal layer covers it on hover. Loud on
       purpose: a bright pulsing core plus two staggered ripples, so the strip draws the eye before anyone scrolls on. */
    :global(.motion) .svg-mask .mask-dot {
      display: block; position: absolute; left: 50%; top: 50%;
      width: 14px; height: 14px; margin: -7px 0 0 -7px; border-radius: 9999px;
      background: var(--color-teal-300);
      box-shadow: 0 0 0 3px rgb(76 198 189 / 0.25), 0 0 18px 4px var(--color-teal-400);
      animation: mask-dot-blink 1.4s ease-in-out var(--d, 0s) infinite;
    }
    :global(.motion) .svg-mask .mask-dot::before,
    :global(.motion) .svg-mask .mask-dot::after {
      content: ''; position: absolute; inset: 0; border-radius: inherit;
      border: 2px solid var(--color-teal-400);
      animation: mask-dot-ring 1.4s var(--ease-out-expo) var(--d, 0s) infinite;
    }
    :global(.motion) .svg-mask .mask-dot::before { animation-delay: calc(var(--d, 0s) + 0.45s); border-width: 1px; }
  }
  @keyframes mask-dot-blink {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.55; transform: scale(0.82); }
  }
  @keyframes mask-dot-ring { from { transform: scale(1); opacity: 0.9; } to { transform: scale(4.6); opacity: 0; } }
  @media (hover: hover) and (pointer: fine) {
    :global(.motion) .svg-mask .mask-reveal {
      display: block;
      mask-image: url('/images/mask-blob.svg');
      -webkit-mask-image: url('/images/mask-blob.svg');
      mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat;
      mask-size: var(--mask-size, 0px) var(--mask-size, 0px);
      -webkit-mask-size: var(--mask-size, 0px) var(--mask-size, 0px);
      mask-position: calc(var(--mask-x, -999px) - var(--mask-size, 0px) / 2) calc(var(--mask-y, -999px) - var(--mask-size, 0px) / 2);
      -webkit-mask-position: calc(var(--mask-x, -999px) - var(--mask-size, 0px) / 2) calc(var(--mask-y, -999px) - var(--mask-size, 0px) / 2);
    }
  }

  .slot { position: relative; display: inline-block; }
  .slot-size { visibility: hidden; }
  /* Out of flow, so a wider rain glyph never changes the slot's width. */
  .slot-live { position: absolute; top: 0; left: 50%; transform: translateX(-50%); white-space: nowrap; }

  /* Pre-state, applied before first paint (the `motion` class is set inline in <head>), so the final figures never
     flash ahead of the scramble. patterns.ts arms the strip; statrain.ts then fills every slot with a glyph.
     Failsafe: if patterns.ts never runs, the figures appear after 2 s. */
  :global(.motion) [data-stat-rain=''] .slot-live,
  :global(.motion) [data-stat-rain='armed'] .slot-live { opacity: 0; }
  :global(.motion) [data-stat-rain=''] .slot-live { animation: statrain-failsafe 0s 2s forwards; }
  @keyframes statrain-failsafe { to { opacity: 1; } }

  /* Waiting for its drop: dim, scrambling. The drop's bright head lands on it and it locks with a short flash. */
  .slot[data-state='scramble'] .slot-live {
    color: color-mix(in srgb, var(--color-teal-500) 70%, transparent);
    font-family: var(--font-mono); font-weight: 400;
  }
  /* Locks slowly: a soft teal blur that sharpens into the ink figure. */
  .slot[data-state='lock'] .slot-live { animation: statrain-lock 1200ms var(--ease-out-expo) both; }
  @keyframes statrain-lock {
    from { color: var(--color-teal-300); text-shadow: 0 0 22px var(--color-teal-400); opacity: 0.35; filter: blur(5px); }
    55% { opacity: 1; filter: blur(0); }
    to { color: var(--color-ink); text-shadow: 0 0 0 transparent; }
  }
  .stat-rain-canvas {
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent),
      linear-gradient(to bottom, transparent, #000 22%, #000 78%, transparent);
    mask-composite: intersect;
  }
</style>
