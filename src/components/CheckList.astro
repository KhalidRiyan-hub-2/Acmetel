---
import Icon from './Icon.astro';
interface Props { items: string[]; columns?: 1 | 2 | 3; class?: string }
const { items, columns = 1, class: className = '' } = Astro.props;
const cols = { 1: '', 2: 'sm:grid-cols-2', 3: 'sm:grid-cols-2 lg:grid-cols-3' }[columns];
---
<ul class:list={['grid gap-3', cols, className]} data-stagger>
  {items.map((i) => (
    <li class="flex items-start gap-3 rounded-xl border border-line bg-white/[0.02] px-4 py-3.5 text-sm text-ink">
      <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-teal-500/20 text-teal-300"><Icon name="check" size={13} /></span>
      {i}
    </li>
  ))}
</ul>
