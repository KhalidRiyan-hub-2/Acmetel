---
// Decorative hero visual: wireframe globe with animated traffic arcs and pulsing PoP nodes.
interface Props { class?: string }
const { class: className = '' } = Astro.props;

const nodes = [
  { x: 150, y: 170 }, { x: 262, y: 128 }, { x: 330, y: 214 }, { x: 214, y: 292 }, { x: 118, y: 268 }, { x: 298, y: 330 },
];
const arcs = [
  'M150 170 Q 200 90 262 128', 'M262 128 Q 330 140 330 214', 'M330 214 Q 290 290 214 292',
  'M214 292 Q 150 300 118 268', 'M118 268 Q 100 200 150 170', 'M150 170 Q 240 230 298 330',
];
---
<div aria-hidden="true" class:list={['relative mx-auto aspect-square w-full max-w-[30rem]', className]}>
  <div class="absolute inset-[12%] rounded-full bg-teal-500/20 blur-3xl"></div>
  <svg viewBox="0 0 440 440" class="relative w-full animate-float">
    <defs>
      <radialGradient id="globe-fill" cx="0.35" cy="0.3" r="0.8">
        <stop stop-color="#22aaa1" stop-opacity="0.28" />
        <stop offset="0.6" stop-color="#202943" stop-opacity="0.6" />
        <stop offset="1" stop-color="#0e1322" stop-opacity="0.9" />
      </radialGradient>
      <linearGradient id="arc-grad" x1="0" x2="1">
        <stop stop-color="#7fdcd5" /><stop offset="1" stop-color="#2fd39a" />
      </linearGradient>
    </defs>
    <circle cx="220" cy="220" r="170" fill="url(#globe-fill)" stroke="#22aaa1" stroke-opacity="0.45" />
    <g fill="none" stroke="#4cc6bd" stroke-opacity="0.16">
      {[40, 85, 125, 155].map((rx) => <ellipse cx="220" cy="220" rx={rx} ry="170" />)}
      {[-110, -55, 0, 55, 110].map((dy) => {
        const r = Math.sqrt(170 * 170 - dy * dy);
        return <ellipse cx="220" cy={220 + dy} rx={r} ry={r * 0.18} />;
      })}
    </g>
    <g class="origin-center animate-[spin_40s_linear_infinite]" style="transform-origin:220px 220px">
      <ellipse cx="220" cy="220" rx="205" ry="70" fill="none" stroke="#22aaa1" stroke-opacity="0.35" stroke-dasharray="4 10" transform="rotate(-22 220 220)" />
    </g>
    <g fill="none" stroke="url(#arc-grad)" stroke-width="2" stroke-linecap="round">
      {arcs.map((d, i) => <path d={d} stroke-dasharray="6 10" class="animate-dash" style={`animation-duration:${1.2 + i * 0.25}s`} />)}
    </g>
    {nodes.map((n, i) => (
      <g>
        <circle cx={n.x} cy={n.y} r="10" fill="#22aaa1" fill-opacity="0.5" class="animate-pulse-ring" style={`transform-origin:${n.x}px ${n.y}px; transform-box:view-box; animation-delay:${i * 0.4}s`} />
        <circle cx={n.x} cy={n.y} r="4.5" fill="#7fdcd5" />
      </g>
    ))}
  </svg>
</div>
