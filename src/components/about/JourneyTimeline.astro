---
// Vertical journey timeline. Steps alternate sides on desktop, stack on a single rail on mobile.
// No dates: steps follow the narrative order of the source copy only.
import Icon, { type IconName } from '../Icon.astro';
interface Step { icon: IconName; title: string; text: string }
interface Props { steps: Step[] }
const { steps } = Astro.props;
---
<ol class="relative mx-auto max-w-5xl" data-stagger>
  <div aria-hidden="true" class="absolute bottom-4 left-6 top-4 w-px bg-gradient-to-b from-teal-500/0 via-teal-500/60 to-teal-500/0 lg:left-1/2"></div>
  {steps.map((s, i) => (
    <li class:list={['relative pb-10 pl-16 last:pb-0 lg:grid lg:grid-cols-2 lg:gap-24 lg:pl-0', i > 0 && 'lg:-mt-20']}>
      <span class="absolute left-0 top-0 grid size-12 place-items-center rounded-full border border-teal-500/40 bg-navy-800 text-teal-300 shadow-[0_0_28px_-6px_rgb(34_170_161/0.7)] lg:left-1/2 lg:-translate-x-1/2">
        <Icon name={s.icon} size={22} />
      </span>
      <div class:list={['glass spotlight p-6 sm:p-7', i % 2 === 0 ? 'lg:col-start-1 lg:text-right' : 'lg:col-start-2']}>
        <p class="eyebrow mb-2">Step {String(i + 1).padStart(2, '0')}</p>
        <h3 class="text-xl font-semibold text-ink">{s.title}</h3>
        <p class="mt-3 text-sm leading-relaxed text-ink-muted sm:text-base">{s.text}</p>
      </div>
    </li>
  ))}
</ol>
