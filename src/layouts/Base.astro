---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props { title: string; description: string }
const { title, description } = Astro.props;
const fullTitle = title === 'Home' ? 'Acmetel | Onward, Forward' : `${title} | Acmetel`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#202943" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/brand/favicon.png" />
    <!-- Before first paint: lets CSS hide elements that motion will bring in (never with reduced motion). -->
    <script is:inline>matchMedia('(prefers-reduced-motion: reduce)').matches || document.documentElement.classList.add('motion');</script>
  </head>
  <body class="overflow-x-clip">
    <!-- Fixed background layers behind the page; sections opt in with data-bg (see src/scripts/patterns.ts). -->
    <div aria-hidden="true" class="bg-layers" data-bg-layers>
      <div class="bg-layer bg-layer-glow" data-bg-layer="glow"></div>
      <div class="bg-layer bg-layer-grid" data-bg-layer="grid"></div>
    </div>
    <!-- Fixed, so it stays outside the smoothed content. -->
    <Header />
    <!-- ScrollSmoother moves #smooth-content inside the fixed #smooth-wrapper (mouse/trackpad only; see motion.ts). -->
    <div id="smooth-wrapper">
      <div id="smooth-content">
        <main id="main" tabindex="-1">
          <slot />
        </main>
        <Footer />
      </div>
    </div>
    <!-- Cursor glare: a soft teal light that follows the pointer over the whole page (mouse/trackpad only, never
         with reduced motion). Fixed, so it lives outside the smoothed content; click-through. -->
    <div aria-hidden="true" class="cursor-glow" data-cursor-glow></div>

    <script>
      import '../scripts/patterns';
      import { gsap, EASE, finePointer } from '../scripts/motion';

      // Scroll reveal for [data-reveal]; children of [data-stagger] get incremental delays.
      document.querySelectorAll<HTMLElement>('[data-stagger]').forEach((group) => {
        [...group.children].forEach((el, i) => {
          (el as HTMLElement).dataset.reveal ??= '';
          (el as HTMLElement).style.setProperty('--reveal-delay', `${i * 70}ms`);
        });
      });
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); } }),
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      // Cursor spotlight on .spotlight cards.
      document.addEventListener('pointermove', (ev) => {
        const card = (ev.target as Element | null)?.closest?.<HTMLElement>('.spotlight');
        if (!card) return;
        const r = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${ev.clientX - r.left}px`);
        card.style.setProperty('--my', `${ev.clientY - r.top}px`);
      }, { passive: true });

      // Cursor glare ([data-cursor-glow]): eases after the pointer; fades out when the pointer leaves the window.
      // While it's on, the static centred glows of `glow` sections are hidden (html.has-cursor-glow).
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && finePointer()) {
        const glow = document.querySelector<HTMLElement>('[data-cursor-glow]');
        if (glow) {
          document.documentElement.classList.add('has-cursor-glow');
          const x = gsap.quickTo(glow, 'x', { duration: 0.6, ease: EASE.out });
          const y = gsap.quickTo(glow, 'y', { duration: 0.6, ease: EASE.out });
          let shown = false;
          document.addEventListener('pointermove', (e) => {
            if (!shown) { gsap.set(glow, { x: e.clientX, y: e.clientY }); glow.classList.add('is-on'); shown = true; }
            x(e.clientX); y(e.clientY);
          }, { passive: true });
          document.documentElement.addEventListener('pointerleave', () => { glow.classList.remove('is-on'); shown = false; });
        }
      }

      // Count-up for [data-count] (value in attribute, formatted with optional suffix in data-suffix).
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const co = new IntersectionObserver((entries) => entries.forEach((e) => {
        if (!e.isIntersecting) return;
        co.unobserve(e.target);
        const el = e.target as HTMLElement;
        const end = Number(el.dataset.count);
        const suffix = el.dataset.suffix ?? '';
        if (reduce) { el.textContent = end + suffix; return; }
        const t0 = performance.now();
        const tick = (t: number) => {
          const p = Math.min(1, (t - t0) / 1400);
          el.textContent = Math.round(end * (1 - Math.pow(1 - p, 4))) + suffix;
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }), { threshold: 0.6 });
      document.querySelectorAll('[data-count]').forEach((el) => co.observe(el));
    </script>
  </body>
</html>
