---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import CheckList from '../../components/CheckList.astro';
import SplitSection from '../../components/SplitSection.astro';
import AnchorNav from '../../components/AnchorNav.astro';
import Button from '../../components/Button.astro';
import CtaBand from '../../components/CtaBand.astro';
import ContactForm from '../../components/ContactForm.astro';
import PhoneMockup from '../../components/PhoneMockup.astro';
import Icon from '../../components/Icon.astro';
import PromiseStrip from '../../components/acmesim/PromiseStrip.astro';
import HowItWorks from '../../components/acmesim/HowItWorks.astro';
import Receipt from '../../components/acmesim/Receipt.astro';
import { acmesimUrl, acmesimStoreUrl } from '../../data/site';

// Copy source: content/source/acmesim.md. Emoji in the source are replaced with <Icon>.
// This page links out to the ACMeSIM site (acmesimUrl) and its store (acmesimStoreUrl).

const usps = [
  { icon: 'zap', title: 'Instant activation', text: 'Instant eSIM activation in seconds.' },
  { icon: 'globe', title: '200+ destinations', text: 'Coverage in 200+ destinations worldwide.' },
  { icon: 'dollar', title: 'Save up to 80%', text: 'Save up to 80% compared to roaming charges.' },
  { icon: 'smartphone', title: 'No physical SIM', text: 'No physical SIM cards required.' },
  { icon: 'eye', title: 'Transparent pricing', text: 'Transparent pricing with no hidden fees.' },
  { icon: 'gauge', title: 'Real-time usage tracking', text: 'Real-time data usage tracking.' },
] as const;

const travel = [
  { icon: 'zap', title: 'One-Tap Setup', text: 'Install your eSIM instantly — no QR codes, no lengthy steps.' },
  { icon: 'globe', title: 'Global Coverage', text: 'Stay connected across 200+ countries and regions.' },
  { icon: 'headset', title: '24/7 Smart Support', text: 'Get help anytime with AI-powered and human support.' },
  { icon: 'users', title: 'Friends & Family Bundles', text: 'Manage multiple eSIMs in one purchase for your loved ones.' },
  { icon: 'download', title: 'Instant Delivery', text: 'Your eSIM is ready before you even land.' },
] as const;

const modern = [
  { icon: 'wifi', t: 'High-speed 5G / 4G connectivity worldwide' },
  { icon: 'activity', t: 'Perfect for streaming, navigation and video calls' },
  { icon: 'network', t: 'Hotspot support for multiple devices' },
  { icon: 'gauge', t: 'Prepaid plans with full control over usage' },
  { icon: 'plane', t: 'Works seamlessly for business and leisure travel' },
] as const;

const surprises = ['Clear, upfront pricing', 'Free eSIM with every purchase', 'No roaming charges', 'No activation fees', 'No hidden costs'];

const bulk = [
  'Purchase eSIMs in bulk at discounted partner rates',
  'Offer global data plans directly to your customers',
  'Perfect for travel agencies, tour operators and corporate travel managers',
  'No infrastructure required: ACMeSIM handles everything',
];

const whiteLabel = [
  { icon: 'globe', t: 'White-label web platform' },
  { icon: 'smartphone', t: 'Custom mobile app (iOS & Android)' },
  { icon: 'sparkles', t: 'Your branding & UI/UX' },
  { icon: 'dollar', t: 'Flexible pricing & plan creation' },
  { icon: 'layers', t: 'Global coverage packages' },
  { icon: 'cpu', t: 'API integrations for your existing systems' },
  { icon: 'chart', t: 'Simple dashboard to manage, assign and track eSIM usage' },
] as const;

const managed = [
  { icon: 'settings', t: 'End-to-end technical setup and onboarding' },
  { icon: 'network', t: 'Global carrier integrations handled by us' },
  { icon: 'server', t: 'Scalable infrastructure to support your growth' },
  { icon: 'headset', t: 'Ongoing support, upgrades and optimization' },
] as const;

const nav = [
  { label: 'For travellers', href: '#why' },
  { label: 'How it works', href: '#how' },
  { label: 'Pricing promise', href: '#transparency' },
  { label: 'For business', href: '#business' },
  { label: 'Partner with us', href: '#partner' },
];

const btnLight = 'group inline-flex h-11 items-center justify-center gap-2 rounded-full border border-line-strong px-5 font-display text-sm font-semibold text-ink transition hover:bg-white/5 active:scale-[0.97]';
---

<Base title="ACMeSIM" description="ACMeSIM: instant eSIM activation, flexible plans and mobile data in 200+ destinations, plus bulk eSIM and white-label platforms for travel businesses.">
  <PageHero
    eyebrow="ACMeSIM"
    title="Smart Global Connectivity,"
    highlight="Simplified"
    lede="Stay connected anywhere in the world with instant eSIM activation, flexible plans and seamless mobile data access, all in one place."
    crumbs={[{ label: 'Products' }, { label: 'ACMeSIM' }]}
  >
    <Button href={acmesimStoreUrl} size="lg" external>Get your eSIM</Button>
    <Button href={acmesimUrl} variant="outline" size="lg" external>Explore plans</Button>
    <div slot="visual" class="relative mx-auto flex max-w-md justify-center py-6 sm:py-10">
      <div class="absolute -left-2 top-2 hidden size-28 animate-float place-items-center rounded-2xl border border-teal-500/30 bg-navy-800/80 text-teal-300 backdrop-blur sm:grid" aria-hidden="true">
        <div class="text-center"><Icon name="globe" size={30} class="mx-auto" /><p class="mt-1.5 font-display text-lg font-bold text-ink">200+</p><p class="text-[0.65rem] text-ink-muted">destinations</p></div>
      </div>
      <PhoneMockup class="z-10">
        <p class="text-xs text-ink-faint">Destination</p>
        <p class="font-display text-lg font-semibold text-ink">United Kingdom</p>
        <div class="mt-4 rounded-2xl bg-gradient-to-br from-teal-500 to-green-700 p-4 text-navy-950">
          <p class="text-xs font-semibold opacity-80">ACTIVE PLAN</p>
          <p class="mt-1 font-display text-2xl font-bold">10 GB <span class="text-sm font-semibold opacity-80">30 days</span></p>
          <div class="mt-3 h-1.5 rounded-full bg-navy-950/20"><div class="h-full w-2/3 rounded-full bg-navy-950/70"></div></div>
          <p class="mt-1.5 text-xs font-medium">6.7 GB remaining</p>
        </div>
        <div class="mt-4 space-y-2">
          {['5G connected', 'Hotspot on', 'No roaming fees'].map((t) => (
            <div class="flex items-center justify-between rounded-xl border border-line bg-white/[0.03] px-3 py-2.5 text-xs text-ink"><span>{t}</span><span class="size-2 rounded-full bg-teal-400"></span></div>
          ))}
        </div>
      </PhoneMockup>
      <PhoneMockup tilt={false} class="absolute -left-4 bottom-0 hidden !w-44 translate-y-6 rotate-[8deg] sm:block">
        <div class="mx-auto grid size-12 place-items-center rounded-full bg-gradient-to-br from-teal-500 to-green-700 text-navy-950"><Icon name="check" size={24} /></div>
        <p class="mt-3 text-center font-display text-sm font-semibold text-ink">eSIM installed</p>
        <p class="mt-1 text-center text-[0.65rem] text-ink-muted">Ready before you land</p>
      </PhoneMockup>
    </div>
  </PageHero>
  <!-- PLACEHOLDER: phone screens are illustrative UI (plan size, days and usage are not real ACMeSIM data). Replace with real app screenshots when available. -->

  <div class="container-x -mt-6 pb-16"><PromiseStrip /></div>

  <AnchorNav items={nav} />

  <!-- Why choose us -->
  <Section id="why">
    <SectionHeading eyebrow="Why choose us" title="Global data that is simple," highlight="affordable and instant" lede="We’re redefining how travellers stay connected abroad." align="center" />
    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
      {usps.map((u) => <FeatureCard icon={u.icon} title={u.title} text={u.text} />)}
    </div>
    <p class="mt-10 text-center font-display text-lg font-semibold text-gradient" data-reveal>Travel smarter, stay connected effortlessly.</p>
  </Section>

  <!-- Built for effortless travel -->
  <Section tone="raised">
    <SectionHeading eyebrow="Service" title="Built for" highlight="effortless travel" lede="Everything you need to stay online, designed for speed, simplicity and freedom." />
    <div class="mt-14 grid gap-5 md:grid-cols-6" data-stagger>
      {travel.map((t, i) => <FeatureCard class={i < 2 ? 'md:col-span-3' : 'md:col-span-2'} icon={t.icon} title={t.title} text={t.text} />)}
    </div>
  </Section>

  <!-- Built for modern travelers -->
  <Section tone="glow">
    <SplitSection reverse>
      <SectionHeading eyebrow="Features" title="Built for" highlight="modern travellers" lede="Designed for how you actually travel, work and connect today." />
      <ul slot="visual" class="grid gap-3" data-stagger>
        {modern.map((m) => (
          <li class="glass flex items-center gap-4 px-5 py-4">
            <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-teal-500/15 text-teal-300"><Icon name={m.icon} size={20} /></span>
            <span class="text-sm text-ink sm:text-base">{m.t}</span>
          </li>
        ))}
      </ul>
    </SplitSection>
  </Section>

  <!-- How it works -->
  <Section id="how" tone="raised">
    <SectionHeading eyebrow="How it works" title="Getting started takes" highlight="less than a minute" lede="Three steps from destination to connected." align="center" />
    <div class="mt-16"><HowItWorks /></div>
    <p class="mt-14 text-center font-display text-lg font-semibold text-ink" data-reveal>No delays. No physical SIM delivery. No hassle.</p>
  </Section>

  <!-- Transparency -->
  <Section id="transparency">
    <SplitSection>
      <SectionHeading eyebrow="Customer satisfaction" title="No surprises." highlight="Ever." lede="We believe in complete transparency, always. What you see is exactly what you pay.">
        <div class="mt-9"><Button href={acmesimStoreUrl} external>Check eSIM bundles now</Button></div>
      </SectionHeading>
      <div slot="visual"><Receipt lines={surprises} /></div>
    </SplitSection>
  </Section>

  <!-- B2B divider -->
  <section id="business" class="relative overflow-hidden border-y border-teal-500/30 bg-gradient-to-br from-green-700/50 via-navy-800 to-navy-800 py-20 sm:py-28">
    <div aria-hidden="true" class="bg-grid pointer-events-none absolute inset-0 opacity-60"></div>
    <div class="container-x relative grid items-center gap-10 lg:grid-cols-[1.2fr_0.8fr]">
      <SectionHeading eyebrow="ACMeSIM Business / Partnerships" title="Sell connectivity." highlight="Or build your own eSIM brand." lede="For travel agencies, tour operators, corporate travel managers and anyone who wants to launch an eSIM business. ACMeSIM supplies the technology." />
      <div class="flex flex-wrap gap-3 lg:justify-end" data-reveal>
        <a href="#partner" class={btnLight}>Partner with ACMeSIM <Icon name="arrow-right" size={16} /></a>
      </div>
    </div>
  </section>

  <!-- Bulk -->
  <Section tone="raised">
    <SplitSection>
      <SectionHeading eyebrow="Bulk eSIM" title="Bulk eSIM solutions for" highlight="travel businesses" lede="Empower your customers with seamless connectivity while unlocking a new revenue stream.">
        <p class="mt-8 font-display text-lg font-semibold text-gradient">Sell smarter. Add connectivity to every journey.</p>
      </SectionHeading>
      <div slot="visual"><CheckList items={bulk} /></div>
    </SplitSection>
  </Section>

  <!-- White label -->
  <Section tone="glow">
    <SectionHeading eyebrow="White-label" title="Launch your own" highlight="eSIM platform" lede="Want to build your own eSIM brand? We provide complete B2B infrastructure to help you launch and scale your own eSIM business: your brand, your rules." align="center" />
    <h3 class="mt-14 text-center font-display text-lg font-semibold text-ink" data-reveal>What you can customise</h3>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
      {whiteLabel.map((w, i) => (
        <li class:list={['glass spotlight flex items-start gap-4 p-5', i === 6 && 'sm:col-span-2']}>
          <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-teal-500/15 text-teal-300"><Icon name={w.icon} size={20} /></span>
          <span class="text-sm leading-relaxed text-ink">{w.t}</span>
        </li>
      ))}
    </ul>
  </Section>

  <!-- Managed -->
  <Section tone="raised">
    <SectionHeading eyebrow="Managed service" title="Fully managed," highlight="fully scalable" lede="We act as your eSIM technology partner, so you can focus on growth." />
    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
      {managed.map((m, i) => (
        <article class="glass spotlight flex h-full flex-col p-6">
          <span class="font-display text-sm font-bold text-teal-400">0{i + 1}</span>
          <Icon name={m.icon} class="mt-4 text-teal-300" />
          <p class="mt-4 text-sm leading-relaxed text-ink">{m.t}</p>
        </article>
      ))}
    </div>
    <p class="mt-10 font-display text-lg font-semibold text-gradient" data-reveal>From idea to launch, we simplify the entire journey.</p>
  </Section>

  <!-- Partner form -->
  <Section id="partner-section">
    <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <SectionHeading eyebrow="Partner with ACMeSIM" title="Let’s kickstart" highlight="your eSIM brand" lede="Ready to grow your business with global eSIM solutions? Fill in your details and our team will get in touch." />
      <ContactForm
        id="partner"
        name="acmesim-partner"
        title="Partner with ACMeSIM"
        text="Tell us what you want to build and our team will get in touch."
        interests={['Bulk eSIM Purchase', 'White-Label Platform', 'API Integration', 'SDK / Mini App Integration']}
        withCompanyLink
      />
    </div>
  </Section>

  <!-- PLACEHOLDER: "Download App" store links (App Store / Google Play) are not provided in the source; linking to acmesimUrl until the client supplies them. -->
  <CtaBand
    title="Ready to travel smarter?"
    text="Join thousands of travellers who’ve switched to instant global connectivity. Stay connected anywhere. Anytime. Instantly."
    primary={{ label: 'Get Your eSIM Now', href: acmesimStoreUrl, external: true }}
    secondary={{ label: 'Download App', href: acmesimUrl, external: true }}
  />
</Base>
