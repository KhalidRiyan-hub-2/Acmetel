---
import Base from '../../../../layouts/Base.astro';
import PageHero from '../../../../components/PageHero.astro';
import Section from '../../../../components/Section.astro';
import SectionHeading from '../../../../components/SectionHeading.astro';
import SplitSection from '../../../../components/SplitSection.astro';
import CheckList from '../../../../components/CheckList.astro';
import Button from '../../../../components/Button.astro';
import Icon from '../../../../components/Icon.astro';
import ContactForm from '../../../../components/ContactForm.astro';
import MoreFromStack from '../../../../components/sis/MoreFromStack.astro';
import { SIS_BASE } from '../../../../data/site';

// Copy source: content/source/sovereign-intelligence-stack.md, "Page 1 – Connectivity (Overview)".
const terrestrial = ['Pakistan–China terrestrial fiber network', 'Low-latency regional connectivity', 'Route diversity and network resilience', 'High-capacity wholesale bandwidth', 'Reliable alternative to submarine-only routes'];
const subsea = ['International submarine cable connectivity', 'Global carrier-grade capacity', 'Access to multiple international routes', 'Enhanced network redundancy', 'Worldwide reach'];
const audience = ['Operators', 'ISPs', 'Carriers', 'Cloud providers', 'Enterprises'];
---

<Base title="Connectivity" description="Wholesale terrestrial transit capacity between Pakistan and China, and global subsea capacity, from Acmetel.">
  <PageHero
    eyebrow="Sovereign Intelligence Stack"
    title="Reliable, scalable"
    highlight="connectivity"
    lede="Connectivity solutions that bridge regional networks with the global internet infrastructure."
    crumbs={[{ label: 'Services' }, { label: 'Sovereign Intelligence Stack', href: SIS_BASE }, { label: 'Connectivity' }]}
  >
    <Button href="#services" size="lg">Our connectivity services</Button>
    <Button href="#contact" variant="outline" size="lg" arrow={false}>Contact us</Button>
    <div slot="visual" aria-hidden="true" class="glass relative overflow-hidden p-6 sm:p-8">
      <div class="bg-grid absolute inset-0 opacity-60"></div>
      <div class="relative space-y-6">
        <div>
          <p class="eyebrow mb-3">Terrestrial fiber</p>
          <div class="flex items-center gap-3">
            <span class="rounded-full border border-teal-500/40 bg-teal-500/10 px-3 py-1.5 text-sm font-semibold text-teal-300">Pakistan</span>
            <svg viewBox="0 0 200 8" class="h-2 flex-1" preserveAspectRatio="none"><line x1="0" y1="4" x2="200" y2="4" stroke="#4cc6bd" stroke-width="2.5" stroke-dasharray="8 8" stroke-linecap="round" class="animate-dash" /></svg>
            <span class="rounded-full border border-teal-500/40 bg-teal-500/10 px-3 py-1.5 text-sm font-semibold text-teal-300">China</span>
          </div>
        </div>
        <div class="h-px bg-line"></div>
        <div>
          <p class="eyebrow mb-3">Subsea capacity</p>
          <div class="flex items-center gap-3">
            <span class="grid size-9 place-items-center rounded-full border border-teal-500/40 bg-teal-500/10 text-teal-300"><Icon name="waves" size={18} /></span>
            <svg viewBox="0 0 200 8" class="h-2 flex-1" preserveAspectRatio="none"><line x1="0" y1="4" x2="200" y2="4" stroke="#2fd39a" stroke-width="2.5" stroke-dasharray="8 8" stroke-linecap="round" class="animate-dash" /></svg>
            <span class="grid size-9 place-items-center rounded-full border border-teal-500/40 bg-teal-500/10 text-teal-300"><Icon name="globe" size={18} /></span>
          </div>
          <p class="mt-3 text-sm text-ink-muted">International submarine cable systems, worldwide reach.</p>
        </div>
      </div>
    </div>
  </PageHero>

  <!-- Intro -->
  <Section>
    <SplitSection>
      <SectionHeading eyebrow="Overview" title="Expand your network reach" highlight="with two complementary services">
        <p class="mt-6 leading-relaxed text-ink-muted">
          At Acmetel, we enable operators, ISPs, carriers, cloud providers, and enterprises to expand their network reach through two complementary connectivity services.
        </p>
        <p class="mt-4 leading-relaxed text-ink-muted">
          Whether you require resilient terrestrial fiber routes across Asia or direct access to international submarine cable systems, our solutions provide secure, high-capacity, and low-latency connectivity designed for modern digital infrastructure.
        </p>
      </SectionHeading>
      <div slot="visual" class="grid gap-4 sm:grid-cols-2" data-stagger>
        <div class="glass spotlight p-6">
          <Icon name="route" class="text-teal-300" />
          <p class="mt-4 font-display font-semibold text-ink">Terrestrial</p>
          <p class="mt-1 text-sm text-ink-muted">Resilient fiber routes across Asia</p>
        </div>
        <div class="glass spotlight p-6 sm:translate-y-6">
          <Icon name="waves" class="text-teal-300" />
          <p class="mt-4 font-display font-semibold text-ink">Subsea</p>
          <p class="mt-1 text-sm text-ink-muted">Direct access to international submarine cable systems</p>
        </div>
        <ul class="glass col-span-full mt-0 flex flex-wrap gap-2 p-5 sm:mt-6" aria-label="Who we serve">
          {audience.map((a) => <li class="rounded-full border border-line-strong px-3 py-1 text-xs text-ink-muted">{a}</li>)}
        </ul>
      </div>
    </SplitSection>
  </Section>

  <!-- Two pillars -->
  <Section id="services" tone="raised">
    <SectionHeading eyebrow="Our connectivity services" title="Two global" highlight="pillars" lede="Our connectivity portfolio is built on two global pillars." />
    <div class="mt-14 grid gap-6 lg:grid-cols-2" data-stagger>
      <article class="glass spotlight flex flex-col p-7 sm:p-9">
        <span class="font-mono text-sm text-teal-400">01</span>
        <h3 class="mt-3 text-2xl font-semibold text-ink">Terrestrial Transit Capacity Wholesale</h3>
        <p class="mt-3 leading-relaxed text-ink-muted">Delivering wholesale optical fiber-based connectivity through strategic terrestrial route connecting Pakistan and China.</p>
        <p class="eyebrow mb-4 mt-8">Highlights</p>
        <CheckList items={terrestrial} />
        <div class="mt-auto pt-9"><Button href={`${SIS_BASE}/connectivity/terrestrial-transit`}>Learn more</Button></div>
      </article>
      <article class="glass spotlight flex flex-col p-7 sm:p-9">
        <span class="font-mono text-sm text-teal-400">02</span>
        <h3 class="mt-3 text-2xl font-semibold text-ink">Global Subsea Capacity Wholesale</h3>
        <p class="mt-3 leading-relaxed text-ink-muted">Providing wholesale capacity through international submarine cable ecosystems for global connectivity.</p>
        <p class="eyebrow mb-4 mt-8">Highlights</p>
        <CheckList items={subsea} />
        <!-- PLACEHOLDER: the source has no subsea subpage, so this pillar gets a contact CTA instead of "Learn more". -->
        <div class="mt-auto pt-9"><Button href="#contact" variant="outline" arrow={false}>Contact us</Button></div>
      </article>
    </div>
  </Section>

  <MoreFromStack exclude={`${SIS_BASE}/connectivity`} />

  <!-- Contact -->
  <Section tone="raised">
    <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <SectionHeading eyebrow="Contact" title="Expand your" highlight="network reach" lede="Tell us about the routes and capacity you need, terrestrial, subsea or both." />
      <ContactForm name="sis-connectivity" topic="Connectivity" title="Talk to our connectivity team" />
    </div>
  </Section>
</Base>
