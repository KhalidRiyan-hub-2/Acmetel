---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import StatStrip from '../components/StatStrip.astro';
import ContactForm from '../components/ContactForm.astro';
import GlobeHero from '../components/home/GlobeHero.astro';
import DynamicHeadline from '../components/home/DynamicHeadline.astro';
import BrandBelt from '../components/home/BrandBelt.astro';
import DealCards from '../components/home/DealCards.astro';
import ServicesRail from '../components/home/ServicesRail.astro';
import LiveNetwork from '../components/home/LiveNetwork.astro';
import WhyAcmetel from '../components/home/WhyAcmetel.astro';
import AcmesimStory from '../components/home/AcmesimStory.astro';
import ProbeTesting from '../components/home/ProbeTesting.astro';
import SmsFirewall from '../components/home/SmsFirewall.astro';
import FraudScan from '../components/home/FraudScan.astro';
import SignalName from '../components/SignalName.astro';
import BlogSection from '../components/home/BlogSection.astro';
import RainGroup from '../components/RainGroup.astro';
import { SIS_BASE } from '../data/site';

// Copy sources: content/source/home-current-site.md and content/source/about.md.
// Section order and merges: docs/superpowers/specs/2026-10-01-homepage-motion-design.md

// The only place these figures appear on the page.
const stats = [
  { value: 150, suffix: '+', label: 'Clients across markets' },
  { value: 6, suffix: 'B+', label: 'Voice minutes terminated yearly' },
  { value: 2, suffix: 'B+', label: 'Messages delivered' },
  { value: 16, label: 'Years in the industry' },
];

// What Acmetel does (content/source/about.md pillars). The "why" lives in WhyAcmetel directly below.
const whoCards = [
  { icon: 'messages', title: 'Telecom solutions', text: 'A2P messaging, wholesale voice and SMS firewall' },
  { icon: 'network', title: 'Global connectivity', text: 'High-capacity terrestrial and cross-border data networks' },
  { icon: 'cloud', title: 'Cloud & data centers', text: 'Public, private and hybrid cloud infrastructure' },
  { icon: 'cpu', title: 'Digital innovation', text: 'AI-driven automation, DPI and the ACMeSIM eSIM app' },
] as const;

const services = [
  // PLACEHOLDER: card photos supplied by the user (public/images/services/, resized copies of public/images/*), not
  // client-approved or licence-checked. Some show third-party brands (EngageLab, Indian operators on the MNP graphic).
  { icon: 'phone', title: 'Voice', href: '/services/voice', image: '/images/services/voice.jpg', imagePos: '50% 45%', text: 'Wholesale voice termination with strong footholds in Pakistan and the GCC, now expanding into Africa. Backed by Tier-1 carriers.' },
  { icon: 'messages', title: 'Messaging', href: '/services/messaging', image: '/images/services/messaging.png', imagePos: '50% 38%', text: 'A2P, P2A and P2P SMS with direct MNO connectivity across EMEA, plus firewall and silent network authentication.' },
  { icon: 'layers', title: 'Sovereign Intelligence Stack', href: SIS_BASE, image: '/images/services/data-center.jpg', imagePos: '50% 50%', text: 'Connectivity, data center, cloud, AI automation and network intelligence. Build your sovereign digital foundation.' },
  { icon: 'hash', title: 'DID & Toll-Free', href: '/services/voice#did-toll-free', image: '/images/services/toll-free.jpg', imagePos: '62% 46%', text: 'Local, toll-free and international toll-free numbers in 25+ countries, connected straight to your PBX.' },
  { icon: 'search', title: 'MNP Lookup', image: '/images/services/mnp.jpg', imagePos: '50% 50%', text: 'Exclusive partner for Pakistan’s MNP database and verification services for international traffic.' },
] as const;

// PLACEHOLDER: event images are hotlinked from acmetel.com (the live site's own event banners, 385×250); copy them
// into the project or serve them from the CMS before launch. The banners carry the name, dates and city in the
// artwork, so they're shown uncropped and the same details repeat as real text under each image.
const events = [
  { name: 'Capacity Europe', date: 'Oct 13–15, 2026', place: 'London, England', image: 'https://acmetel.com/wp-content/uploads/2026/04/05-Capacity-Europe.jpg' },
  { name: 'GCCM Middle East', date: 'Nov 1–4, 2026', place: 'Muscat, Oman', image: 'https://acmetel.com/wp-content/uploads/2026/04/06-GCCM-Oman.jpg' },
  { name: 'Africa Tech Festival', date: 'Nov 17–19, 2026', place: 'Cape Town, South Africa', image: 'https://acmetel.com/wp-content/uploads/2026/04/07-Africa-tech.jpg' },
];
---

<Base title="Home" description="Acmetel delivers wholesale voice, A2P messaging, SMS firewall, eSIM and sovereign digital infrastructure for telecom operators and enterprises worldwide.">
  <!-- 1. Hero -->
  <section class="relative overflow-hidden pt-28 pb-12 sm:pt-32">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
      <div class="bg-grid absolute inset-0"></div>
      <div class="absolute -left-32 top-0 h-[36rem] w-[36rem] animate-aurora rounded-full bg-teal-500/12 blur-3xl"></div>
      <div class="absolute -right-40 top-40 h-[30rem] w-[30rem] animate-aurora rounded-full bg-green-700/25 blur-3xl [animation-delay:-8s]"></div>
    </div>
    <div class="container-x relative grid items-center gap-10 lg:grid-cols-[1.05fr_0.95fr]">
      <div>
        <DynamicHeadline class="text-[2.35rem] font-bold leading-[1.06] text-ink sm:text-[3.4rem] lg:text-[3.6rem] xl:text-[4rem]" data-reveal style="--reveal-delay:80ms" />
        <p class="mt-7 max-w-xl text-lg leading-relaxed text-ink-muted" data-reveal style="--reveal-delay:160ms">
          One partner for the full connectivity stack, from voice, messaging and eSIM to the networks underneath them.
        </p>
        <div class="mt-10 flex flex-wrap gap-3" data-reveal style="--reveal-delay:240ms">
          <Button href="#services" size="lg">Explore services</Button>
          <Button href="/contact" variant="outline" size="lg" arrow={false}>Talk to our team</Button>
        </div>
      </div>
      <GlobeHero />
    </div>
    <div class="container-x relative mt-12 sm:mt-14"><StatStrip stats={stats} mask /></div>
  </section>

  <!-- 2. Brand belt -->
  <Section tight>
    <p class="eyebrow mb-14 text-center" data-reveal>Trusted by operators and platforms worldwide</p>
    <BrandBelt />
  </Section>

  <!-- 3. Who we are -->
  <Section>
    <DealCards cards={[...whoCards]}>
      <SectionHeading eyebrow="Who we are" title="A platform that encompasses" highlight="business ideas">
        <p class="mt-6 leading-relaxed text-ink-muted">
          Acmetel provides reliable telecommunication services to businesses of every size, and has done for over a decade. Our team has deep industry experience and one job: keeping clients connected, efficient and competitive.
        </p>
        <div class="mt-8"><Button href="/about" variant="outline">Our story</Button></div>
      </SectionHeading>
    </DealCards>
  </Section>

  <!-- Brand band: "Acmetel" drawn by signal threads, over the live-site hero line (home-current-site.md "Hero"). -->
  <SignalName text="Empowering seamless communication" highlight="in the digital age." bg="glow" />

  <!-- 4. Why choose Acmetel -->
  <WhyAcmetel />

  <!-- 5. Services -->
  <ServicesRail id="services" services={[...services]}>
    <SectionHeading eyebrow="Services" title="The primary services" highlight="we offer" lede="Carrier-grade voice and messaging, and the sovereign infrastructure underneath them." />
  </ServicesRail>

  <!-- 6. Products: ACMeSIM story -->
  <AcmesimStory />

  <!-- 6a. Products for operators: the brand band's click-to-draw signal threads spelling "Operators", over the
       title, then one section per product. Lede reuses the line from the former operator-products header. -->
  <!-- One code rain behind both the Operators band and SMS Firewall, so it doesn't restart at the band edge. -->
  <RainGroup>
    <SignalName word="Operators" srWord={false} text="Products for" highlight="operators">
      <p class="mt-5 max-w-xl text-ink-muted sm:text-lg">Protection for messaging and voice revenue, from filtering to fraud detection and network testing.</p>
    </SignalName>

    <!-- 6b. SMS Firewall (messaging.md "Firewall & Security Solutions") -->
    <SmsFirewall rain={false} />
  </RainGroup>

  <!-- 6c. Fraud Management (voice.md "Fraud Management & Revenue Assurance") -->
  <FraudScan />

  <!-- 6d. Probe Testing (messaging.md "Network Penetration Testing (NPT)") -->
  <ProbeTesting />

  <!-- 7. Live network -->
  <LiveNetwork />

  <!-- 8. Latest insights: featured article + latest posts (src/data/blog.ts; WordPress-ready) -->
  <BlogSection />

  <!-- 8b. Upcoming events -->
  <Section id="events" tone="glow">
    <SectionHeading eyebrow="Events" title="Meet us at" highlight="upcoming events" />
    <!-- Three event cards: the event's own banner (uncropped, 77:50), then date, name, city and the meeting link. -->
    <ul class="mt-10 grid gap-6 md:grid-cols-3" data-stagger>
      {events.map((e) => (
        <li>
          <article class="glass spotlight group relative flex h-full flex-col overflow-hidden outline-offset-3 has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-teal-400">
            <div class="relative aspect-[77/50] overflow-hidden bg-navy-950">
              <img src={e.image} width="385" height="250" alt={`${e.name}, ${e.date}, ${e.place}`} loading="lazy" decoding="async"
                class="size-full object-cover transition-transform duration-700 group-hover:scale-[1.03]" />
            </div>
            <div class="flex flex-1 flex-col p-5 sm:p-6">
              <p class="flex items-center gap-2 font-mono text-xs text-teal-300"><Icon name="calendar" size={14} />{e.date}</p>
              <h3 class="mt-3 font-display text-lg font-semibold leading-snug text-ink transition-colors group-hover:text-teal-300">
                <!-- Stretched link: the whole card opens the contact page. -->
                <a href="/contact" class="after:absolute after:inset-0 after:z-10 focus-visible:outline-none">{e.name}</a>
              </h3>
              <p class="mt-1.5 flex items-center gap-1.5 text-sm text-ink-muted"><Icon name="map-pin" size={14} />{e.place}</p>
              <span class="mt-auto inline-flex items-center gap-2 pt-5 text-sm font-semibold text-teal-300" aria-hidden="true">
                Book a meeting<Icon name="arrow-right" size={16} class="transition-transform group-hover:translate-x-1" />
              </span>
            </div>
          </article>
        </li>
      ))}
    </ul>
  </Section>

  <!-- 9. Contact -->
  <Section tone="raised">
    <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <SectionHeading eyebrow="Contact" title="Let’s build what’s" highlight="next together" lede="Join a global network of trusted telecom partners. Tell us about your traffic, your network or your next launch." />
      <ContactForm name="home-contact" title="Get in touch" />
    </div>
  </Section>
</Base>
